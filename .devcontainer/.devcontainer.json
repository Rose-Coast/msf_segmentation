{
  "name": "Python ML Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  
  "features": {
    "ghcr.io/devcontainers/features/nvidia-cuda:1": {
      "installCudaLabs": true,
      "cudaVersion": "12.1"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  // Ensure the remote user is in the docker group inside the container
  
  "postCreateCommand": "pip install --upgrade pip && pip install torch torchvision torchaudio numpy pandas scikit-learn matplotlib jupyterlab && sudo chown vscode /var/run/docker.sock || sudo groupadd -f docker && sudo usermod -aG docker vscode",

  "remoteUser": "vscode",
  "containerUser": "vscode",
  "runArgs": ["--gpus", "all"]
}
